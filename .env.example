# API URL
# - For iOS Simulator / Web: http://localhost:5000
# - For Android Emulator: http://10.0.2.2:5000 (auto-mapped from localhost if in emulator)
# - For Physical Device on Wi-Fi: http://<YOUR_COMPUTER_LOCAL_IP>:5000 or use `adb reverse tcp:5000 tcp:5000`
# - For Production: https://api.cngbharat.com
EXPO_PUBLIC_API_URL="http://localhost:5000"
EXPO_PUBLIC_APP_ENV="development"
EXPO_PUBLIC_ENABLE_DEV_PAYMENT_SIMULATION="true"
EXPO_PUBLIC_ENABLE_VOICE_DEMO_QUERIES="true"
