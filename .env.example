# ============================================================
# CNG Bharat Mobile App — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in the appropriate values.
# NEVER commit .env to version control.
# ============================================================

# --- Required ---

# The base URL of the CNG Bharat backend API (no trailing slash)
EXPO_PUBLIC_API_URL=https://your-backend.example.com

# Application environment: development | staging | production
EXPO_PUBLIC_APP_ENV=production

# Whether to show only Google CNG stations on the map
EXPO_PUBLIC_SHOW_ONLY_GOOGLE_CNG=false

# --- Optional: Dev/Test Only ---
# These flags are ONLY effective when __DEV__ is true (Expo Go / local builds).
# They are completely ignored in production release builds.

# Enable payment simulation in Expo Go (no Razorpay native module)
# Set to true ONLY for local dev testing. Never enable in production.
# EXPO_PUBLIC_ENABLE_DEV_PAYMENT_SIMULATION=false

# Enable hardcoded voice demo queries for offline testing
# EXPO_PUBLIC_ENABLE_VOICE_DEMO_QUERIES=false

# --- Security ---

# Google Maps SDK key is NOT stored here.
# Apply Android SHA-1 fingerprint + package name and iOS Bundle ID
# restrictions via Google Cloud Console.
# Inject the restricted key via EAS Secrets for production builds:
#   eas secret:create --scope project --name GOOGLE_MAPS_API_KEY --value "AIza..."
# Then reference it in app.config.js:
#   android: { config: { googleMaps: { apiKey: process.env.GOOGLE_MAPS_API_KEY } } }

# Optional: Comma-separated SHA-256 SSL public key pins for certificate pinning
# EXPO_PUBLIC_SSL_PINS=sha256/AAAA...,sha256/BBBB...
