{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["esnext", "dom"],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["expo-maps", "jest"],
    "typeRoots": ["./types", "./node_modules/@types"],
    "declaration": true,
    "composite": false
  }
}
