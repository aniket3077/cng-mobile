{
  "cli": {
    "version": ">= 20.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.cngbharat.com",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_SHOW_ONLY_GOOGLE_CNG": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.cngbharat.com",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_SHOW_ONLY_GOOGLE_CNG": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
