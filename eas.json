{
  "cli": {
    "version": ">= 18.13.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "android": {
        "buildType": "apk"
      },
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://cng-backend.vercel.app",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_SHOW_ONLY_GOOGLE_CNG": "true"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://cng-backend.vercel.app",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_SHOW_ONLY_GOOGLE_CNG": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
